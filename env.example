# Copy to `.env` (git-ignored) and fill the values. Never commit the real file.
# Root credentials are only used by the one-off `init` job; the running app never uses them.
SURREAL_ROOT_USER=root
SURREAL_ROOT_PASSWORD=change-me

# Role users created by `db init` (the application connects only with these)
SRAG_SURREAL_INGEST_PASSWORD=change-me
SRAG_SURREAL_API_RO_PASSWORD=change-me
SRAG_SURREAL_API_RW_PASSWORD=change-me
SRAG_SURREAL_AUDIT_WRITER_PASSWORD=change-me
SRAG_SURREAL_AUDIT_READER_PASSWORD=change-me
SRAG_SURREAL_KG_WRITER_PASSWORD=change-me

# Main model (large tier), as an ORDERED failover list: the first usable provider serves and the next
# is tried when it fails. A provider with no key/endpoint/package is skipped. Fill the models you use.
SRAG_LLM_PRIORITY=openrouter=<model>,groq=<model>,nvidia=<model>,unsloth=<model>,google_genai=<model>,ollama=<model>
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# SRAG_NVIDIA_BASE_URL=http://nim.local:8000/v1     # only for a self-hosted NIM
# Unsloth (or any OpenAI-compatible server: vLLM, llama.cpp...): the endpoint is required, the key optional
SRAG_UNSLOTH_BASE_URL=
UNSLOTH_API_KEY=
GOOGLE_API_KEY=
# Ollama on the host machine, seen from a container (no key needed)
SRAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Single-provider alternative to the list above (anthropic needs ANTHROPIC_API_KEY):
# SRAG_LLM_PROVIDER=groq
# SRAG_LLM_MODEL=<model>
# Structured output method for every tier when a server needs it: function_calling | json_schema | json_mode
# SRAG_LLM_STRUCTURED_METHOD=

# Optional small and judge tiers (both provider and model, or neither)
# SRAG_ROUTER_SMALL_PROVIDER=openrouter
# SRAG_ROUTER_SMALL_MODEL=
# SRAG_ROUTER_JUDGE_PROVIDER=
# SRAG_ROUTER_JUDGE_MODEL=

# Provider packages for the image build (Anthropic is always included). All of the listed providers:
LLM_EXTRAS=--extra openrouter --extra groq --extra nvidia --extra unsloth --extra google --extra ollama

# API keys (comma-separated bearer tokens; generate with: openssl rand -hex 32). Required under compose.
SRAG_API_KEYS=change-me
# SRAG_API_RATE_PER_MINUTE=10
# SRAG_API_MAX_CONCURRENT=2
# SRAG_API_MAX_BODY_BYTES=1024

GRAFANA_ADMIN_PASSWORD=change-me
